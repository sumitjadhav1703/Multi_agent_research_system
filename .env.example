# ResearchMind V1 (Streamlit)
GROQ_API_KEY=replace_with_your_groq_key
TAVILY_API_KEY=replace_with_your_tavily_key

# ResearchMind 2.0 backend
APP_ENV=development
ALLOW_PAID_MODELS=false
USE_MOCK_PROVIDER=false

# Optional additional free-tier providers (server-side only)
GEMINI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Offline DeepEval / Meta Llama API only. Not a public or frontend provider.
LLAMA_API_KEY=

# gemini/gemini-2.0-flash was shut down 2026-06-01 (Milestone 2 live smoke: HTTP 404).
# gemini/gemini-flash-latest is LiteLLM's current Flash alias. Live completion was not re-run.
# Keep the retired id allowlisted so an environment that still names it can boot.
FREE_MODEL_ALLOWLIST=groq/openai/gpt-oss-20b,gemini/gemini-flash-latest,gemini/gemini-2.0-flash,mistral/mistral-small-latest,openrouter/meta-llama/llama-3.2-3b-instruct:free,mock/free-model

# Role model aliases (must be subset of FREE_MODEL_ALLOWLIST)
PLANNER_PRIMARY_MODEL=groq/openai/gpt-oss-20b
PLANNER_FALLBACK_MODEL=gemini/gemini-flash-latest
RESEARCH_PRIMARY_MODEL=groq/openai/gpt-oss-20b
RESEARCH_FALLBACK_MODEL=gemini/gemini-flash-latest
VERIFIER_PRIMARY_MODEL=gemini/gemini-flash-latest
VERIFIER_FALLBACK_MODEL=mistral/mistral-small-latest
WRITER_PRIMARY_MODEL=groq/openai/gpt-oss-20b
WRITER_FALLBACK_MODEL=mistral/mistral-small-latest
EVAL_JUDGE_PRIMARY_MODEL=gemini/gemini-flash-latest
EVAL_JUDGE_FALLBACK_MODEL=

LITELLM_NUM_RETRIES=0
LITELLM_REQUEST_TIMEOUT=45
LITELLM_MAX_FALLBACK_ATTEMPTS=1

# Milestone 3 persistence and quotas. Values stay server-side. Do not commit a real DATABASE_URL.
DATABASE_URL=
QUEUE_CONSUMER_ENABLED=true
QUEUE_POLL_SECONDS=0.5
JOB_LEASE_SECONDS=60
JOB_HEARTBEAT_SECONDS=15
JOB_MAX_ATTEMPTS=3
GLOBAL_MAX_ACTIVE_RUNS=1
GLOBAL_DAILY_RUN_CAP=3
MAX_MODEL_CALLS_PER_RUN=12
MAX_RUN_WALL_CLOCK_SECONDS=180
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
GUEST_TOKEN_TTL_HOURS=336
# Auto-delete research jobs (and orphan guest rows) older than N days.
# Runs on API startup and about once per hour inside the queue consumer.
DATA_RETENTION_ENABLED=true
DATA_RETENTION_DAYS=2
DATA_RETENTION_INTERVAL_SECONDS=3600
DATA_RETENTION_BATCH_SIZE=100
# Leave WORKER_ID unset. Each process then uses hostname-pid-random.
# A shared value lets two processes finalize each other's leases.

# Exact browser origins for the Research Console. Comma-separated, no paths, no "*".
# Empty keeps the API same-origin only (Vite's dev proxy does not need CORS).
# Example after a frontend deploy: https://researchmind-console.onrender.com
# Startup fails if this contains a wildcard, a path, or userinfo.
CORS_ORIGINS=

# Milestone 5 observability. Names only. An empty endpoint keeps traces local (no export).
# Do not put credentials in these values in git. OTEL_EXPORTER_OTLP_HEADERS is read by the
# exporter and is not written to ResearchMind logs.
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=researchmind
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO

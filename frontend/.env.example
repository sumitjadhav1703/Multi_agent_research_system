# Empty uses same-origin /api. The Vite dev and preview servers proxy that to
# http://127.0.0.1:8000. For a deployed static site, set the public API origin
# with no trailing path, for example https://researchmind-api.onrender.com.
# That origin must also be listed in the API's CORS_ORIGINS. This is the only
# client-visible API setting. Do not put provider keys or DATABASE_URL here.
VITE_API_BASE=

# Public Cloudflare Turnstile site key. Leave empty to show a token field.
# Never put TURNSTILE_SECRET_KEY, provider keys, or DATABASE_URL here.
VITE_TURNSTILE_SITE_KEY=
